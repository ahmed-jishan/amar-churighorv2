rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Product images: admin upload, public read
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Hero images: admin only
    match /hero/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
