rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // CORE HELPERS
    // =====================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function userExists() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSuspended() {
      return userExists() &&
        userDoc().data.isSuspended == true;
    }

    function getRole() {
      return userExists() ? userDoc().data.role : null;
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        userExists() &&
        !isSuspended() &&
        getRole() == "super_admin";
    }

    function isAdmin() {
      return isSignedIn() &&
        userExists() &&
        !isSuspended() &&
        getRole() == "admin";
    }

    function isAdminOrSuperAdmin() {
      return isAdmin() || isSuperAdmin();
    }

    // =====================================================
    // PRODUCTS
    // =====================================================

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    // =====================================================
    // CATEGORIES
    // =====================================================

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    // =====================================================
    // ORDERS
    // =====================================================

    match /orders/{orderId} {
      allow create: if true;
      allow read: if isAdminOrSuperAdmin() || (
        request.query.trackingToken != null &&
        resource.data.trackingToken == request.query.trackingToken
      );
      allow update, delete: if isAdminOrSuperAdmin();
    }

    // =====================================================
    // HERO SLIDES
    // =====================================================

    match /hero_slides/{slideId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    // =====================================================
    // FAQS
    // =====================================================

    match /faqs/{faqId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    // =====================================================
    // REVIEWS
    // =====================================================

    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    // =====================================================
    // SECTION CONFIG (homepage section settings)
    // =====================================================

    match /section_config/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    // =====================================================
    // CAMPAIGNS (offer campaigns & promotions)
    //   Public read - anyone can see active campaigns
    //   Admin write - only admins can manage campaigns
    // =====================================================

    match /campaigns/{campaignId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    // =====================================================
    // SETTINGS
    // =====================================================

    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    // =====================================================
    // ADMIN MANAGEMENT
    // =====================================================

    match /admins/{adminId} {
      // Any signed-in user reads their OWN doc (for role check on login)
      allow read: if isSignedIn() && request.auth.uid == adminId;
      // Super admin can read/list/write all admin docs
      allow read, list: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    // =====================================================
    // ANALYTICS — FIX: separate write into create+update+delete
    // Public can CREATE (tracking). Admin can do everything.
    // =====================================================

    match /visitor_sessions/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdminOrSuperAdmin();
    }

    match /page_views/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdminOrSuperAdmin();
    }

    match /product_views/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdminOrSuperAdmin();
    }

    // FIX: "allow write" was missing read for admin on free tier
    // Explicitly split into create (public) + read/update/delete (admin)
    match /analytics_daily/{docId} {
      allow create, update: if true;
      allow read, delete: if isAdminOrSuperAdmin();
    }

    match /analytics_monthly/{docId} {
      allow create, update: if true;
      allow read, delete: if isAdminOrSuperAdmin();
    }

    // =====================================================
    // DEFAULT DENY
    // =====================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}