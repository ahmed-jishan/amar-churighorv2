rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // CORE HELPERS
    // =====================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function userExists() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSuspended() {
      return userExists() &&
        userDoc().data.isSuspended == true;
    }

    function getRole() {
      return userExists() ? userDoc().data.role : null;
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        userExists() &&
        !isSuspended() &&
        getRole() == "super_admin";
    }

    function isAdmin() {
      return isSignedIn() &&
        userExists() &&
        !isSuspended() &&
        getRole() == "admin";
    }

    function isAdminOrSuperAdmin() {
      return isAdmin() || isSuperAdmin();
    }

    // =====================================================
    // PRODUCTS
    // =====================================================

    match /products/{productId} {
      allow read: if true;
      allow list: if true;
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    // =====================================================
    // CATEGORIES
    // =====================================================

    match /categories/{categoryId} {
      allow read: if true;
      allow list: if true;
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    // =====================================================
    // ORDERS
    //   FIX: Added allow list for getDocs queries (e.g. notify-order API)
    // =====================================================

    match /orders/{orderId} {
      allow create: if true;
      allow read: if isAdminOrSuperAdmin() || (
        request.query.trackingToken != null &&
        resource.data.trackingToken == request.query.trackingToken
      );
      allow list: if isAdminOrSuperAdmin() || (
        request.query.trackingToken != null
      );
      allow update, delete: if isAdminOrSuperAdmin();
    }

    // =====================================================
    // HERO SLIDES
    // =====================================================

    match /hero_slides/{slideId} {
      allow read: if true;
      allow list: if true;
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    // =====================================================
    // FAQS
    // =====================================================

    match /faqs/{faqId} {
      allow read: if true;
      allow list: if true;
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    // =====================================================
    // REVIEWS
    // =====================================================

    match /reviews/{reviewId} {
      allow read: if true;
      allow list: if true;
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    // =====================================================
    // SECTION CONFIG (homepage section settings)
    // =====================================================

    match /section_config/{docId} {
      allow read: if true;
      allow list: if true;
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    // =====================================================
    // CAMPAIGNS (offer campaigns & promotions)
    //   FIX: Added allow list for getDocs queries (loyalty service, offers page)
    //   Public list allows querying, app-level filtering handles active/expired
    // =====================================================

    match /campaigns/{campaignId} {
      // Public single-doc read: only active campaigns
      allow read: if resource.data.isActive == true;
      // Public query (list): allows getDocs for filtering at app level
      allow list: if true;
      // Admin can read all (including inactive/expired)
      allow read: if isAdminOrSuperAdmin();
      allow list: if isAdminOrSuperAdmin();
      // Only admins can create/update/delete
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    // =====================================================
    // SETTINGS
    // =====================================================

    match /settings/{settingId} {
      allow read: if true;
      allow list: if true;
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    // =====================================================
    // ADMIN MANAGEMENT
    // =====================================================

    match /admins/{adminId} {
      // Any signed-in user reads their OWN doc (for role check on login)
      allow read: if isSignedIn() && request.auth.uid == adminId;
      // Super admin can read/list/write all admin docs
      allow read, list: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    // =====================================================
    // ANALYTICS
    //   Public can CREATE (tracking). Admin can do everything.
    // =====================================================

    match /visitor_sessions/{docId} {
      allow create: if true;
      allow read, list, update, delete: if isAdminOrSuperAdmin();
    }

    match /page_views/{docId} {
      allow create: if true;
      allow read, list, update, delete: if isAdminOrSuperAdmin();
    }

    match /product_views/{docId} {
      allow create: if true;
      allow read, list, update, delete: if isAdminOrSuperAdmin();
    }

    match /analytics_daily/{docId} {
      allow create, update: if true;
      allow read, list, delete: if isAdminOrSuperAdmin();
    }

    match /analytics_monthly/{docId} {
      allow create, update: if true;
      allow read, list, delete: if isAdminOrSuperAdmin();
    }

    // =====================================================
    // CUSTOMERS (loyalty profiles)
    //   FIX: Added allow list for getDocs queries (findCustomerByEmailPhone)
    //   Public list + create — queries are filtered by email+phone at app level
    // =====================================================

    match /customers/{customerId} {
      allow read: if true;
      allow list: if true;
      allow create: if true;
      allow update, delete: if isAdminOrSuperAdmin();
    }

    // =====================================================
    // CUSTOMER REWARDS (loyalty reward records)
    //   FIX: Added allow list for getDocs queries (getAvailableRewards, hasRewardForCampaign, validateRewardForCustomer)
    //   Public list + create — queries filtered by customerKey/couponCode at app level
    // =====================================================

    match /customer_rewards/{rewardId} {
      allow read: if true;
      allow list: if true;
      allow create: if true;
      allow update, delete: if isAdminOrSuperAdmin();
    }

    // =====================================================
    // TRUST BAR (footer trust indicators)
    // =====================================================

    match /trust_bar/{docId} {
      allow read: if true;
      allow list: if true;
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    // =====================================================
    // FOOTER CONFIG
    // =====================================================

    match /footer_config/{docId} {
      allow read: if true;
      allow list: if true;
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    // =====================================================
    // CONTENT PAGES
    // =====================================================

    match /content/{docId} {
      allow read: if true;
      allow list: if true;
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    // =====================================================
    // FLASH SALE
    // =====================================================

    match /flash_sale/{docId} {
      allow read: if true;
      allow list: if true;
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    // =====================================================
    // WHY CHOOSE US
    // =====================================================

    match /why_choose_us/{docId} {
      allow read: if true;
      allow list: if true;
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    // =====================================================
    // NEWSLETTER
    // =====================================================

    match /newsletter/{docId} {
      allow read: if true;
      allow list: if true;
      allow create: if true;
      allow update, delete: if isAdminOrSuperAdmin();
    }

    // =====================================================
    // UGC GALLERY
    // =====================================================

    match /ugc_gallery/{docId} {
      allow read: if true;
      allow list: if true;
      allow create: if true;
      allow update, delete: if isAdminOrSuperAdmin();
    }

    // =====================================================
    // DEFAULT DENY — catch all for unlisted collections
    // =====================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}