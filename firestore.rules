rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdminUser() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isSuspended == false;
    }

    function isSuperAdmin() {
      return isAdminUser() &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin';
    }

    // Admins can read/write everything
    function isAdminOrSuper() {
      return isAdminUser() || isSuperAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write, delete: if isAdminOrSuper();
    }

    match /categories/{catId} {
      allow read: if true;
      allow write, delete: if isAdminOrSuper();
    }

    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdminOrSuper();
    }

    // ── ADMINS COLLECTION ──────────────────────────────
    // Security rules:
    //   - Any signed-in user can read their OWN admin doc (for login/status check)
    //   - Only super_admin can READ all admin docs (admin list page)
    //   - Only super_admin can CREATE/UPDATE/DELETE admin docs
    //   - Suspended users are blocked by isAdminUser()/isSuperAdmin() checks
    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update, delete: if isSuperAdmin();
    }

    match /hero_slides/{id} {
      allow read: if true;
      allow write, delete: if isAdminOrSuper();
    }

    match /faqs/{id} {
      allow read: if true;
      allow write, delete: if isAdminOrSuper();
    }

    match /reviews/{id} {
      allow read: if true;
      allow write, delete: if isAdminOrSuper();
    }

    match /settings/{id} {
      allow read: if true;
      allow write, delete: if isAdminOrSuper();
    }

  }
}