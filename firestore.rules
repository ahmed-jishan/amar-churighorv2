rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // CORE HELPERS
    // =====================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function userExists() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSuspended() {
      return userExists() &&
        userDoc().data.isSuspended == true;
    }

    function getRole() {
      return userExists() ? userDoc().data.role : null;
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        userExists() &&
        !isSuspended() &&
        getRole() == "super_admin";
    }

    function isAdmin() {
      return isSignedIn() &&
        userExists() &&
        !isSuspended() &&
        getRole() == "admin";
    }

    function isAdminOrSuperAdmin() {
      return isAdmin() || isSuperAdmin();
    }

    // =====================================================
    // PRODUCTS
    // =====================================================

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    // =====================================================
    // CATEGORIES
    // =====================================================

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    // =====================================================
    // ORDERS
    // =====================================================

    match /orders/{orderId} {
      allow create: if true;
      allow read: if isAdminOrSuperAdmin() || (
        // Token-gated public read for order tracking
        request.query.trackingToken != null &&
        resource.data.trackingToken == request.query.trackingToken
      );
      allow update, delete: if isAdminOrSuperAdmin();
    }

    // =====================================================
    // HERO SLIDES
    // =====================================================

    match /hero_slides/{slideId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    // =====================================================
    // FAQS
    // =====================================================

    match /faqs/{faqId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    // =====================================================
    // REVIEWS
    // =====================================================

    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    // =====================================================
    // SETTINGS (store config — accessible by any active admin)
    // =====================================================

    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    // =====================================================
    // ADMIN MANAGEMENT (CRITICAL)
    //   - Any signed-in user can read their OWN admin doc
    //   - Any active admin can LIST all (read-only view)
    //   - ONLY super_admin can create/update/delete admins
    // =====================================================

    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow read: if isSuperAdmin();
      allow list: if isAdminOrSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // =====================================================
    // DEFAULT DENY (BEST PRACTICE)
    // =====================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}