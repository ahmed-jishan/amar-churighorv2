[debug] [2026-06-18T22:11:09.619Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/amar-churighor/rulesets {"name":"projects/amar-churighor/rulesets/0132e6d2-e4d9-41f1-a493-1177ec1a4885","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // =====================================================\n    // CORE HELPERS\n    // =====================================================\n\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function userDoc() {\n      return get(/databases/$(database)/documents/admins/$(request.auth.uid));\n    }\n\n    function userExists() {\n      return isSignedIn() &&\n        exists(/databases/$(database)/documents/admins/$(request.auth.uid));\n    }\n\n    function isSuspended() {\n      return userExists() &&\n        userDoc().data.isSuspended == true;\n    }\n\n    function getRole() {\n      return userExists() ? userDoc().data.role : null;\n    }\n\n    function isSuperAdmin() {\n      return isSignedIn() &&\n        userExists() &&\n        !isSuspended() &&\n        getRole() == \"super_admin\";\n    }\n\n    function isAdmin() {\n      return isSignedIn() &&\n        userExists() &&\n        !isSuspended() &&\n        getRole() == \"admin\";\n    }\n\n    function isAdminOrSuperAdmin() {\n      return isAdmin() || isSuperAdmin();\n    }\n\n    // =====================================================\n    // PRODUCTS\n    // =====================================================\n\n    match /products/{productId} {\n      allow read: if true;\n      allow list: if true;\n      allow create, update, delete: if isAdminOrSuperAdmin();\n    }\n\n    // =====================================================\n    // CATEGORIES\n    // =====================================================\n\n    match /categories/{categoryId} {\n      allow read: if true;\n      allow list: if true;\n      allow create, update, delete: if isAdminOrSuperAdmin();\n    }\n\n    // =====================================================\n    // ORDERS\n    //   FIX: Added allow list for getDocs queries (e.g. notify-order API)\n    // =====================================================\n\n    match /orders/{orderId} {\n      allow create: if true;\n      allow read: if isAdminOrSuperAdmin() || (\n        request.query.trackingToken != null &&\n        resource.data.trackingToken == request.query.trackingToken\n      );\n      allow list: if isAdminOrSuperAdmin() || (\n        request.query.trackingToken != null\n      );\n      allow update, delete: if isAdminOrSuperAdmin();\n    }\n\n    // =====================================================\n    // HERO SLIDES\n    // =====================================================\n\n    match /hero_slides/{slideId} {\n      allow read: if true;\n      allow list: if true;\n      allow create, update, delete: if isAdminOrSuperAdmin();\n    }\n\n    // =====================================================\n    // FAQS\n    // =====================================================\n\n    match /faqs/{faqId} {\n      allow read: if true;\n      allow list: if true;\n      allow create, update, delete: if isAdminOrSuperAdmin();\n    }\n\n    // =====================================================\n    // REVIEWS\n    // =====================================================\n\n    match /reviews/{reviewId} {\n      allow read: if true;\n      allow list: if true;\n      allow create, update, delete: if isAdminOrSuperAdmin();\n    }\n\n    // =====================================================\n    // SECTION CONFIG (homepage section settings)\n    // =====================================================\n\n    match /section_config/{docId} {\n      allow read: if true;\n      allow list: if true;\n      allow create, update, delete: if isAdminOrSuperAdmin();\n    }\n\n    // =====================================================\n    // CAMPAIGNS (offer campaigns & promotions)\n    //   FIX: Added allow list for getDocs queries (loyalty service, offers page)\n    //   Public list allows querying, app-level filtering handles active/expired\n    // =====================================================\n\n    match /campaigns/{campaignId} {\n      // Public single-doc read: only active campaigns\n      allow read: if resource.data.isActive == true;\n      // Public query (list): allows getDocs for filtering at app level\n      allow list: if true;\n      // Admin can read all (including inactive/expired)\n      allow read: if isAdminOrSuperAdmin();\n      allow list: if isAdminOrSuperAdmin();\n      // Only admins can create/update/delete\n      allow create, update, delete: if isAdminOrSuperAdmin();\n    }\n\n    // =====================================================\n    // SETTINGS\n    // =====================================================\n\n    match /settings/{settingId} {\n      allow read: if true;\n      allow list: if true;\n      allow create, update, delete: if isAdminOrSuperAdmin();\n    }\n\n    // =====================================================\n    // ADMIN MANAGEMENT\n    // =====================================================\n\n    match /admins/{adminId} {\n      // Any signed-in user reads their OWN doc (for role check on login)\n      allow read: if isSignedIn() && request.auth.uid == adminId;\n      // Super admin can read/list/write all admin docs\n      allow read, list: if isSuperAdmin();\n      allow create, update, delete: if isSuperAdmin();\n    }\n\n    // =====================================================\n    // ANALYTICS\n    //   Public can CREATE (tracking). Admin can do everything.\n    // =====================================================\n\n    match /visitor_sessions/{docId} {\n      allow create: if true;\n      allow read, list, update, delete: if isAdminOrSuperAdmin();\n    }\n\n    match /page_views/{docId} {\n      allow create: if true;\n      allow read, list, update, delete: if isAdminOrSuperAdmin();\n    }\n\n    match /product_views/{docId} {\n      allow create: if true;\n      allow read, list, update, delete: if isAdminOrSuperAdmin();\n    }\n\n    match /analytics_daily/{docId} {\n      allow create, update: if true;\n      allow read, list, delete: if isAdminOrSuperAdmin();\n    }\n\n    match /analytics_monthly/{docId} {\n      allow create, update: if true;\n      allow read, list, delete: if isAdminOrSuperAdmin();\n    }\n\n    // =====================================================\n    // CUSTOMERS (loyalty profiles)\n    //   FIX: Added allow list for getDocs queries (findCustomerByEmailPhone)\n    //   Public list + create — queries are filtered by email+phone at app level\n    // =====================================================\n\n    match /customers/{customerId} {\n      allow read: if true;\n      allow list: if true;\n      allow create: if true;\n      allow update, delete: if isAdminOrSuperAdmin();\n    }\n\n    // =====================================================\n    // CUSTOMER REWARDS (loyalty reward records)\n    //   FIX: Added allow list for getDocs queries (getAvailableRewards, hasRewardForCampaign, validateRewardForCustomer)\n    //   Public list + create — queries filtered by customerKey/couponCode at app level\n    // =====================================================\n\n    match /customer_rewards/{rewardId} {\n      allow read: if true;\n      allow list: if true;\n      allow create: if true;\n      allow update, delete: if isAdminOrSuperAdmin();\n    }\n\n    // =====================================================\n    // TRUST BAR (footer trust indicators)\n    // =====================================================\n\n    match /trust_bar/{docId} {\n      allow read: if true;\n      allow list: if true;\n      allow create, update, delete: if isAdminOrSuperAdmin();\n    }\n\n    // =====================================================\n    // FOOTER CONFIG\n    // =====================================================\n\n    match /footer_config/{docId} {\n      allow read: if true;\n      allow list: if true;\n      allow create, update, delete: if isAdminOrSuperAdmin();\n    }\n\n    // =====================================================\n    // CONTENT PAGES\n    // =====================================================\n\n    match /content/{docId} {\n      allow read: if true;\n      allow list: if true;\n      allow create, update, delete: if isAdminOrSuperAdmin();\n    }\n\n    // =====================================================\n    // FLASH SALE\n    // =====================================================\n\n    match /flash_sale/{docId} {\n      allow read: if true;\n      allow list: if true;\n      allow create, update, delete: if isAdminOrSuperAdmin();\n    }\n\n    // =====================================================\n    // WHY CHOOSE US\n    // =====================================================\n\n    match /why_choose_us/{docId} {\n      allow read: if true;\n      allow list: if true;\n      allow create, update, delete: if isAdminOrSuperAdmin();\n    }\n\n    // =====================================================\n    // NEWSLETTER\n    // =====================================================\n\n    match /newsletter/{docId} {\n      allow read: if true;\n      allow list: if true;\n      allow create: if true;\n      allow update, delete: if isAdminOrSuperAdmin();\n    }\n\n    // =====================================================\n    // UGC GALLERY\n    // =====================================================\n\n    match /ugc_gallery/{docId} {\n      allow read: if true;\n      allow list: if true;\n      allow create: if true;\n      allow update, delete: if isAdminOrSuperAdmin();\n    }\n\n    // =====================================================\n    // DEFAULT DENY — catch all for unlisted collections\n    // =====================================================\n\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}","name":"firestore.rules"}]},"createTime":"2026-06-18T22:11:09.825759Z","metadata":{"services":["cloud.firestore"]}}
