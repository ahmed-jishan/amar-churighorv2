[debug] [2026-06-17T20:22:43.657Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/amar-churighor/rulesets {"name":"projects/amar-churighor/rulesets/ca81a6ee-fe3c-477f-9a0b-d05d2f65318d","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // =====================================================\n    // CORE HELPERS\n    // =====================================================\n\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function userDoc() {\n      return get(/databases/$(database)/documents/admins/$(request.auth.uid));\n    }\n\n    function userExists() {\n      return isSignedIn() &&\n        exists(/databases/$(database)/documents/admins/$(request.auth.uid));\n    }\n\n    function isSuspended() {\n      return userExists() &&\n        userDoc().data.isSuspended == true;\n    }\n\n    function getRole() {\n      return userExists() ? userDoc().data.role : null;\n    }\n\n    function isSuperAdmin() {\n      return isSignedIn() &&\n        userExists() &&\n        !isSuspended() &&\n        getRole() == \"super_admin\";\n    }\n\n    function isAdmin() {\n      return isSignedIn() &&\n        userExists() &&\n        !isSuspended() &&\n        getRole() == \"admin\";\n    }\n\n    function isAdminOrSuperAdmin() {\n      return isAdmin() || isSuperAdmin();\n    }\n\n    // =====================================================\n    // PRODUCTS\n    // =====================================================\n\n    match /products/{productId} {\n      allow read: if true;\n      allow create, update, delete: if isAdminOrSuperAdmin();\n    }\n\n    // =====================================================\n    // CATEGORIES\n    // =====================================================\n\n    match /categories/{categoryId} {\n      allow read: if true;\n      allow create, update, delete: if isAdminOrSuperAdmin();\n    }\n\n    // =====================================================\n    // ORDERS\n    // =====================================================\n\n    match /orders/{orderId} {\n      allow create: if true;\n      allow read: if isAdminOrSuperAdmin() || (\n        request.query.trackingToken != null &&\n        resource.data.trackingToken == request.query.trackingToken\n      );\n      allow update, delete: if isAdminOrSuperAdmin();\n    }\n\n    // =====================================================\n    // HERO SLIDES\n    // =====================================================\n\n    match /hero_slides/{slideId} {\n      allow read: if true;\n      allow create, update, delete: if isAdminOrSuperAdmin();\n    }\n\n    // =====================================================\n    // FAQS\n    // =====================================================\n\n    match /faqs/{faqId} {\n      allow read: if true;\n      allow create, update, delete: if isAdminOrSuperAdmin();\n    }\n\n    // =====================================================\n    // REVIEWS\n    // =====================================================\n\n    match /reviews/{reviewId} {\n      allow read: if true;\n      allow create, update, delete: if isAdminOrSuperAdmin();\n    }\n\n    // =====================================================\n    // SECTION CONFIG (homepage section settings)\n    // =====================================================\n\n    match /section_config/{docId} {\n      allow read: if true;\n      allow create, update, delete: if isAdminOrSuperAdmin();\n    }\n\n    // =====================================================\n    // CAMPAIGNS (offer campaigns & promotions)\n    //   Public read - anyone can see active campaigns\n    //   Admin write - only admins can manage campaigns\n    // =====================================================\n\n    match /campaigns/{campaignId} {\n      allow read: if true;\n      allow create, update, delete: if isAdminOrSuperAdmin();\n    }\n\n    // =====================================================\n    // SETTINGS\n    // =====================================================\n\n    match /settings/{settingId} {\n      allow read: if true;\n      allow create, update, delete: if isAdminOrSuperAdmin();\n    }\n\n    // =====================================================\n    // ADMIN MANAGEMENT\n    // =====================================================\n\n    match /admins/{adminId} {\n      // Any signed-in user reads their OWN doc (for role check on login)\n      allow read: if isSignedIn() && request.auth.uid == adminId;\n      // Super admin can read/list/write all admin docs\n      allow read, list: if isSuperAdmin();\n      allow create, update, delete: if isSuperAdmin();\n    }\n\n    // =====================================================\n    // ANALYTICS — FIX: separate write into create+update+delete\n    // Public can CREATE (tracking). Admin can do everything.\n    // =====================================================\n\n    match /visitor_sessions/{docId} {\n      allow create: if true;\n      allow read, update, delete: if isAdminOrSuperAdmin();\n    }\n\n    match /page_views/{docId} {\n      allow create: if true;\n      allow read, update, delete: if isAdminOrSuperAdmin();\n    }\n\n    match /product_views/{docId} {\n      allow create: if true;\n      allow read, update, delete: if isAdminOrSuperAdmin();\n    }\n\n    // FIX: \"allow write\" was missing read for admin on free tier\n    // Explicitly split into create (public) + read/update/delete (admin)\n    match /analytics_daily/{docId} {\n      allow create, update: if true;\n      allow read, delete: if isAdminOrSuperAdmin();\n    }\n\n    match /analytics_monthly/{docId} {\n      allow create, update: if true;\n      allow read, delete: if isAdminOrSuperAdmin();\n    }\n\n    // =====================================================\n    // DEFAULT DENY\n    // =====================================================\n\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}","name":"firestore.rules"}]},"createTime":"2026-06-17T20:22:43.577087Z","metadata":{"services":["cloud.firestore"]}}
